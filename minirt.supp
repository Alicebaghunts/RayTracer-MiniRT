# MiniLibX linux shared lib (most common)
{
   ignore_minilibx_linux_leaks
   Memcheck:Leak
   ...
   obj:*/libmlx*.so*
}

# X11 allocations (expected "still reachable" / sometimes "definitely lost")
{
   ignore_libx11_leaks
   Memcheck:Leak
   ...
   obj:*/libX11.so.*
}

{
   ignore_libxext_leaks
   Memcheck:Leak
   ...
   obj:*/libXext.so.*
}

# xcb (often used underneath X11)
{
   ignore_libxcb_leaks
   Memcheck:Leak
   ...
   obj:*/libxcb.so.*
}

# Sometimes shows up on some distros
{
   ignore_libxrender_leaks
   Memcheck:Leak
   ...
   obj:*/libXrender.so.*
}
